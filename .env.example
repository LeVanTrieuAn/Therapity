# ═══════════════════════════════════════════════════════════
# THERAPITY — Environment Configuration
# ═══════════════════════════════════════════════════════════

# === App ===
APP_NAME=Therapity
APP_VERSION=4.0.0
DEBUG=true

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql+asyncpg://therapity:therapity_dev@localhost:5432/therapity
POSTGRES_PASSWORD=therapity_dev

# === Security (JWT) ===
JWT_SECRET_KEY=your_jwt_secret_key_change_this_in_production_32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# === LLM (OpenRouter) ===
OPENROUTER_API_KEY=your_openrouter_api_key
LLM_MODEL=google/gemini-2.0-flash-exp:free

# === CORS ===
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
